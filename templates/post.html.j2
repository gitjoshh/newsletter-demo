<!doctype html>
<html lang="{{ site.language | default('en') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ post.title }} - {{ site.title }}</title>
<meta name="description" content="{{ post.excerpt }}">
<link rel="canonical" href="{{ site.base_url }}/posts/{{ post.slug }}/">

{# Open Graph: every photo in the post is offered so the Facebook composer's
   image picker can cycle through them. The hero is listed first (the default,
   and what Bluesky / Threads pick since they take only the first). #}
{% set og_imgs = [] %}
{% if post.hero and post.hero.filename %}{% set _ = og_imgs.append(post.hero) %}{% endif %}
{% for b in post.blurbs %}{% if b.image and b.image.filename %}{% set _ = og_imgs.append(b.image) %}{% endif %}{% endfor %}
{% if post.deepdive.image and post.deepdive.image.filename %}{% set _ = og_imgs.append(post.deepdive.image) %}{% endif %}
{% set og_title = '“' ~ post.title ~ '”' ~ (' - ' ~ site.og_title_suffix if site.og_title_suffix else '') %}
<meta property="og:type" content="article">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{{ og_title }}">
<meta property="og:description" content="{{ post.excerpt }}">
<meta property="og:url" content="{{ site.base_url }}/posts/{{ post.slug }}/">
{% for im in og_imgs %}
<meta property="og:image" content="{{ site.base_url }}/posts/{{ post.slug }}/{{ im.filename }}">
<meta property="og:image:secure_url" content="{{ site.base_url }}/posts/{{ post.slug }}/{{ im.filename }}">
{% if im.width and im.height %}<meta property="og:image:width" content="{{ im.width }}">
<meta property="og:image:height" content="{{ im.height }}">
{% endif %}<meta property="og:image:alt" content="{{ im.alt }}">
{% endfor %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title }}">
<meta name="twitter:description" content="{{ post.excerpt }}">
{% if og_imgs %}<meta name="twitter:image" content="{{ site.base_url }}/posts/{{ post.slug }}/{{ og_imgs[0].filename }}">{% endif %}

<style>{{ style_css }}</style>
</head>
<body>
<div class="wrap">
  <div class="masthead"><a href="{{ site.base_url }}/">{{ site.title }}</a></div>
  <article>
    <h1>{{ post.title }}</h1>
    {% if post.subtitle %}<p class="subtitle">{{ post.subtitle }}</p>{% endif %}
    <div class="meta">
      {{ post.date }} &middot; {{ site.author }}
      {% if post.tags %}<div style="margin-top:.5em">{% for t in post.tags %}<span class="tag">{{ t }}</span>{% endfor %}</div>{% endif %}
    </div>

    {% if post.hero %}
    <figure>
      <img src="{{ post.hero.src }}" alt="{{ post.hero.alt }}">
      <figcaption>{{ post.hero.attribution_html | safe }}</figcaption>
    </figure>
    {% endif %}

    {{ post.intro_html | safe }}

    {% for b in post.blurbs %}
    <h2>{{ b.title }}</h2>
    {% if b.image %}
    <figure>
      <img src="{{ b.image.src }}" alt="{{ b.image.alt }}">
      <figcaption>{{ b.image.attribution_html | safe }}</figcaption>
    </figure>
    {% endif %}
    {{ b.body_html | safe }}
    {% endfor %}

    <hr>
    <h2>{{ post.deepdive.title }}</h2>
    {% if post.deepdive.image %}
    <figure>
      <img src="{{ post.deepdive.image.src }}" alt="{{ post.deepdive.image.alt }}">
      <figcaption>{{ post.deepdive.image.attribution_html | safe }}</figcaption>
    </figure>
    {% endif %}
    {{ post.deepdive.body_html | safe }}

    {{ post.closing_html | safe }}

    {% if post.sources %}
    <hr>
    <p class="sources"><strong>Sources:</strong>
      {% for s in post.sources %}<a href="{{ s.url }}">{{ s.text or s.url }}</a>{% if not loop.last %} &middot; {% endif %}{% endfor %}
    </p>
    {% endif %}
  </article>
</div>
</body>
</html>
