<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<style>
  body { font-family: Georgia, 'Times New Roman', serif; max-width: 640px; margin: 0 auto;
    padding: 22px; color: #222; line-height: 1.6; }
  h1 { font-size: 1.5rem; margin: 0 0 .3em; }
  .sub { color: #777; margin: 0 0 1.4em; }
  .box { background: #f4f4f4; border: 1px solid #ddd; border-radius: 6px;
    padding: 14px 16px; white-space: pre-wrap; font-family: inherit; }
  .cap { color: #888; font-size: .82rem; margin-top: .5em; }
  a { color: #b5341f; }
  img { max-width: 100%; height: auto; border-radius: 6px; margin-top: 1em; }
</style>
</head>
<body>
  <h1>Ready to post &mdash; &ldquo;{{ post_title }}&rdquo;</h1>
  <p class="sub">The post is live: <a href="{{ post_url }}">{{ post_url }}</a></p>

  <p>Copy whichever post you want and paste it into Facebook / Threads. The newsletter
  teaser links the post; the film posts stand alone. Save the photo underneath
  (long-press on phone, right-click on desktop) if you want it on the post.</p>

  <p><strong>Newsletter teaser</strong></p>
  <div class="box">{{ teaser_text }}</div>
  {% for f in film_posts %}
  <p style="margin-top:1.2em"><strong>{{ f.title }}</strong> &mdash; standalone post</p>
  <div class="box">{{ f.text }}</div>
  {% endfor %}

  {% if teaser_image %}
  <p style="margin-top:1.6em"><strong>Suggested photo for the newsletter teaser</strong> &mdash;
    <a href="{{ teaser_image.url }}">download</a></p>
  <img src="{{ teaser_image.src }}" alt="{{ teaser_image.alt }}">
  <div class="cap">{{ teaser_image.attribution_html | safe }}</div>
  {% endif %}

  {% if all_images %}
  <h2 style="font-family:Helvetica,Arial,sans-serif;font-size:1.1rem;margin-top:2em">All photos (right-click / long-press the link to save)</h2>
  <ul>
    {% for im in all_images %}
    <li><strong>{{ im.label }}</strong> &mdash; <a href="{{ im.url }}">{{ im.filename }}</a></li>
    {% endfor %}
  </ul>
  <p class="cap">Film stills are courtesy of TMDB; the mood photo carries its own credit on the post.</p>
  {% endif %}
</body>
</html>
