:root {
  --bg: {{ style.color.bg }};
  --surface: {{ style.color.surface }};
  --text: {{ style.color.text }};
  --muted: {{ style.color.muted }};
  --accent: {{ style.color.accent }};
  --border: {{ style.color.border }};
  --link: {{ style.color.link }};
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: {{ style.font.body }};
  font-size: 18px;
  line-height: 1.7;
}
.wrap { max-width: {{ style.layout.content_width }}; margin: 0 auto; padding: 48px 20px 96px; }
a { color: var(--link); }
h1, h2, h3, .masthead { font-family: {{ style.font.heading }}; line-height: 1.25; }
h1 { font-size: 2.1rem; margin: 0 0 .2em; }
.subtitle { color: var(--muted); font-size: 1.15rem; margin: 0 0 1.5em; }
.masthead { font-size: .95rem; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
.masthead a { color: var(--muted); text-decoration: none; }
.meta { color: var(--muted); font-size: .9rem; margin-bottom: 2em; }
.tag { display: inline-block; border: 1px solid var(--border); border-radius: 999px;
  padding: 1px 10px; margin-right: 6px; font-size: .8rem; color: var(--muted); }
figure { margin: 2em 0; }
figure img { width: 100%; height: auto; border-radius: {{ style.layout.radius }}; display: block; background: var(--surface); }
figcaption { color: var(--muted); font-size: .8rem; margin-top: .5em; }
figcaption a { color: var(--muted); }
h2 { font-size: 1.5rem; margin: 2em 0 .4em; }
blockquote { border-left: 3px solid var(--accent); margin: 1.5em 0; padding: .2em 0 .2em 1.2em; color: var(--muted); font-style: italic; }
hr { border: none; border-top: 1px solid var(--border); margin: 3em 0; }
.sources { font-size: .85rem; color: var(--muted); }
.index-list { list-style: none; padding: 0; }
.index-list li { border-bottom: 1px solid var(--border); padding: 1.2em 0; }
.index-list a.title { font-family: {{ style.font.heading }}; font-size: 1.3rem; text-decoration: none; }
.callout { background: var(--surface); border: 1px solid var(--border); border-radius: {{ style.layout.radius }}; padding: 16px 20px; margin: 1.5em 0; }
.copybox { white-space: pre-wrap; background: var(--surface); border: 1px solid var(--border);
  border-radius: {{ style.layout.radius }}; padding: 16px; font-family: {{ style.font.body }}; font-size: 1rem; }
