<!doctype html>
<html lang="{{ site.language | default('en') }}">
<head>
<meta charset="utf-8">
<meta name="robots" content="noindex">
<title>{{ post.title }} - {{ site.title }}</title>
<link rel="canonical" href="{{ post_url }}">

{# A share stub: same post, but THIS photo leads so Facebook's link card uses it.
   og:url points at this stub (self-referential) so Facebook keeps it as its own
   scrape instead of collapsing to the canonical post. Humans are redirected. #}
<meta property="og:type" content="article">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{{ post.title }}">
<meta property="og:description" content="{{ post.excerpt }}">
<meta property="og:url" content="{{ share_url }}">
{% for im in images %}
<meta property="og:image" content="{{ site.base_url }}/posts/{{ post.slug }}/{{ im.filename }}">
<meta property="og:image:secure_url" content="{{ site.base_url }}/posts/{{ post.slug }}/{{ im.filename }}">
{% if im.width and im.height %}<meta property="og:image:width" content="{{ im.width }}">
<meta property="og:image:height" content="{{ im.height }}">
{% endif %}<meta property="og:image:alt" content="{{ im.alt }}">
{% endfor %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ post.title }}">
<meta name="twitter:description" content="{{ post.excerpt }}">
{% if images %}<meta name="twitter:image" content="{{ site.base_url }}/posts/{{ post.slug }}/{{ images[0].filename }}">{% endif %}

<meta http-equiv="refresh" content="0; url={{ post_url }}">
<script>location.replace({{ post_url | tojson }});</script>
<style>body{font-family:Georgia,serif;max-width:32rem;margin:4rem auto;padding:0 1rem;color:#222}</style>
</head>
<body>
<p>Taking you to <a href="{{ post_url }}">{{ post.title }}</a>&hellip;</p>
</body>
</html>
