# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------

# --- LLM / AI ---
# Used by draft_post.py, draft_teaser.py, find_horror_angle.py, classify_reply.py
ANTHROPIC_API_KEY=
# Optional: default is claude-opus-5. Set claude-sonnet-5 to lower per-run cost.
# ANTHROPIC_MODEL=claude-sonnet-5
# Optional: only if find_horror_angle.py 400s about the web search tool type.
# ANTHROPIC_WEB_SEARCH_TOOL=web_search_20250305

# --- Film stills (fetch_images.py) ---
# TMDB provides scene stills (backdrops) per film. Free key:
# https://www.themoviedb.org/settings/api  (v3 key OR v4 read token)
TMDB_API_KEY=
# TMDB_READ_TOKEN=

# --- Stock / mood photos (fetch_images.py) ---
# Used for the deep-dive running/endurance photo and as a hero fallback.
# Openverse works with no key; these raise the anonymous rate limit if set.
# OPENVERSE_CLIENT_ID=
# OPENVERSE_CLIENT_SECRET=
# Pexels: https://www.pexels.com/api/
PEXELS_API_KEY=
# Unsplash: https://unsplash.com/developers  (use the "Access Key")
UNSPLASH_ACCESS_KEY=

# --- Static site (publish_site.py) ---
# A local folder (NOT necessarily a git repo) where the pipeline writes the site.
SITE_REPO_PATH=
# Cloudflare Pages deploy. Either run `npx wrangler login` once, or set both of
# these for non-interactive deploys (Pages project must already exist).
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# --- Gmail ---
# The scheduled Claude routine reads/sends mail through the granted Gmail connection (MCP),
# so no key is needed here. This is just the label the Letterboxd Rushes email lands under;
# it is also mirrored in config/newsletter.json.
# LETTERBOXD_GMAIL_LABEL=Letterboxd
